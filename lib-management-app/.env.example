# =============================================================================
# SDK Management Application — Environment Configuration
# Copy this file to .env and fill in the values below.
# manage.sh will source .env automatically on startup.
# =============================================================================

# ── REQUIRED in production ────────────────────────────────────────────────────

# Shared secret for service-to-service calls (X-Internal-Service-Key header)
# Used by ALL FastAPI services. Must be the same across all services.
INTERNAL_SERVICE_KEY=change-me-to-a-long-random-string

# JWT signing secret for api-gateway (any strong random string)
JWT_SECRET_KEY=change-me-to-another-long-random-string

# First-run admin user password (api-gateway creates this on first start)
DEFAULT_ADMIN_PASSWORD=changeme

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero config):
DATABASE_URL=sqlite+aiosqlite:///./db/library_management.db

# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lib_management

# ── Service URLs (change only if running on non-default ports/hosts) ──────────
LIBRARY_DATA_SERVICE_URL=http://localhost:8001
SCRAPER_SERVICE_URL=http://localhost:8002
COMPARISON_SERVICE_URL=http://localhost:8003
RECOMMENDATION_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005
SCHEDULER_SERVICE_URL=http://localhost:8006
API_GATEWAY_URL=http://localhost:8000

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron expression for the automated pipeline run
SCHEDULE_CRON=0 2 * * *
# Set to false to disable automatic runs
SCHEDULE_ENABLED=true

# ── JWT token lifetime ────────────────────────────────────────────────────────
JWT_EXPIRE_MINUTES=480

# ── Email (SMTP) notifications — leave blank to disable ──────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=library-mgmt@example.com
# Comma-separated default recipient list
DEFAULT_EMAIL_RECIPIENTS=

# ── Microsoft Teams notifications — leave blank to disable ───────────────────
TEAMS_WEBHOOK_URL=

# ── LLM-powered recommendations — leave blank to use rule-based mode ─────────
# Examples: openai | azure | ollama/llama3 | anthropic/claude-3-haiku-20240307
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Required for Azure OpenAI or Ollama
LLM_API_BASE=

# ── Debug mode (verbose logging) ──────────────────────────────────────────────
DEBUG=false
