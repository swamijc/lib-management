# ══════════════════════════════════════════════════════════════════
#  SDK Management Application — Environment Variables Template
#  Copy this file to docker/.env and fill in all values before
#  running docker compose up.
#
#  NEVER commit docker/.env to source control.
# ══════════════════════════════════════════════════════════════════

# ── Core Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
INTERNAL_SERVICE_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
DB_ENCRYPTION_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# ── Default Admin Account (seeded at first migration) ─────────────
DEFAULT_ADMIN_USERNAME=admin
# Password MUST be changed on first login
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:////app/db/library_management.db

# ── API Gateway ───────────────────────────────────────────────────
API_GATEWAY_URL=http://api-gateway:8000

# ── Email (SMTP) — managed via UI after first deploy ──────────────
# These are fallback defaults; Admin can override via UI Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=library-mgmt@yourorg.com
EMAIL_RECIPIENTS=["team@yourorg.com"]
EMAIL_ENABLED=true

# ── Microsoft Teams ───────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
TEAMS_ENABLED=false

# ── Scheduler ─────────────────────────────────────────────────────
SCHEDULE_CRON=0 8 * * 1
SCHEDULE_TIMEZONE=UTC
SCHEDULE_ENABLED=true

# ── Scraper ───────────────────────────────────────────────────────
GITHUB_TOKEN=
SCRAPER_CACHE_TTL_HOURS=6

# ── LLM (managed via UI after first deploy) ───────────────────────
# Provider options: openai | azure_openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_API_VERSION=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_ENABLED=false

# ── DB Backup ─────────────────────────────────────────────────────
DB_BACKUP_KEEP_COUNT=7

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Debug (set to false in production) ───────────────────────────
DEBUG=false
